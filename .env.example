# Salin jadi agent/.env, isi dengan PAPER keys dari dashboard Alpaca (paper).
# Jangan pernah commit file .env. Jangan pernah pakai live keys di proyek ini.
# Catatan: file INI adalah template — jangan pernah isi keys asli di sini.
APCA_API_KEY_ID=your-paper-key-id
APCA_API_SECRET_KEY=your-paper-secret-key
APCA_API_BASE_URL=https://paper-api.alpaca.markets
